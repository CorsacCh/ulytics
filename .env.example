# ── LOCAL ── copia este archivo a .env y ajusta las claves.
# El .env NUNCA se sube a git.

# ═══ Base de datos ═══
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_DATABASE=test
MYSQL_USER=manager_test
MYSQL_PASSWORD=cambia-esta-clave

# ═══ Backend ═══
PORT=4000
DB_HOST=grupo0_db            # nombre del servicio de la BD en docker
DB_PORT=3306
DB_USER=manager_test         # = MYSQL_USER
DB_PASSWORD=cambia-esta-clave # = MYSQL_PASSWORD
DB_NAME=test                 # = MYSQL_DATABASE
ORIGIN=http://localhost:3000 # URL del frontend, para CORS

# ═══ Frontend (Vite) ═══
VITE_APP_HOST=0.0.0.0
VITE_APP_PORT=3000
VITE_BACKEND_URL=http://localhost:4000   # backend visto por el NAVEGADOR (sin /api al final)
VITE_ALLOWED_HOSTS=localhost
