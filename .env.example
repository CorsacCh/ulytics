# Configuración general de Docker Compose para desarrollo local.
# Copia este archivo como .env en la raíz del repositorio.
#
# Cada servicio usa además su propio archivo privado:
#   database/.env  <- database/.env.example
#   backend/.env   <- backend/.env.example
#   frontend/.env  <- frontend/.env.example

COMPOSE_PROJECT_NAME=grupo4_ulytics
