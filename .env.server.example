# GUÍA DE ENTORNO PARA EL SERVIDOR DEL GRUPO 4
#
# Este archivo es documentación: no se copia como un único .env.
# Crea directamente en el servidor los tres archivos indicados abajo.
# Nunca guardes aquí ni en Git contraseñas, JWT_SECRET o credenciales SSH reales.
# Los valores CAMBIAR_* son marcadores y no son credenciales válidas.
#
# ADVERTENCIA: la guía del curso entrega actualmente una URL HTTP. No uses
# contraseñas reales en ese entorno hasta que el responsable del proxy Caddy
# confirme HTTPS. Cuando exista TLS, cambia ambas URLs a https:// y define
# COOKIE_SECURE=true en backend/.env.

# ── grupo4/database/.env ────────────────────────────────────────────────────
POSTGRES_DB=ulytics
POSTGRES_USER=ulytics_app
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# ── grupo4/backend/.env ─────────────────────────────────────────────────────
PORT=4004
NODE_ENV=production
# Caddy es el único proxy entre Internet y el backend.
TRUST_PROXY_HOPS=1
DB_HOST=grupo4_db
DB_PORT=5432
DB_NAME=ulytics
DB_USER=ulytics_app
# Debe coincidir exactamente con POSTGRES_PASSWORD de database/.env.
DB_PASSWORD=CAMBIAR_POR_LA_MISMA_CLAVE_DE_DATABASE

ORIGIN=http://grupo4.146.83.216.166.nip.io
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=8h
# Valor temporal mientras el acceso del curso sea HTTP. Cambiar a true con HTTPS.
COOKIE_SECURE=false
INSTITUTIONAL_EMAIL_DOMAIN=uach.cl

# Solo se completan temporalmente para crear el primer administrador.
# Deben volver a quedar vacías después de ejecutar create:initial-admin.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ── grupo4/frontend/.env ────────────────────────────────────────────────────
# Las variables VITE_* llegan al navegador y nunca deben contener secretos.
VITE_APP_HOST=0.0.0.0
VITE_APP_PORT=3004
VITE_BACKEND_URL=http://grupo4.146.83.216.166.nip.io
VITE_ALLOWED_HOSTS=grupo4.146.83.216.166.nip.io
