# Copia este archivo como backend/.env y reemplaza las claves.
# No subas backend/.env al repositorio.

PORT=4004
NODE_ENV=development
TRUST_PROXY_HOPS=0
DB_HOST=grupo4_db
DB_PORT=5432
DB_NAME=ulytics
DB_USER=ulytics_app
DB_PASSWORD=usar-la-misma-clave-de-database-env

ORIGIN=http://localhost:3004,http://127.0.0.1:3004

# Configuración requerida por la autenticación implementada.
# JWT_SECRET debe ser distinto en cada entorno y no debe subirse a Git.
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
INSTITUTIONAL_EMAIL_DOMAIN=uach.cl

# Credenciales de un solo uso para crear el primer administrador.
# Completa únicamente en backend/.env; nunca uses valores reales aquí.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
